# ==================================================
# TradSense - Environment Variables
# ==================================================
# Salin file ini menjadi .env dan isi dengan value yang sesuai

# Finnhub API Key (gratis di https://finnhub.io)
FINNHUB_API_KEY=your_finnhub_api_key_here

# Telegram Bot Token (buat di @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Chat ID (gunakan @userinfobot untuk mendapatkan)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Google Gemini API Key (dapatkan di https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Gemini (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Log Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
